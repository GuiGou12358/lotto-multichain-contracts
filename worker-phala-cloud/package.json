{
  "name": "price-feed-oracle-phala-cloud",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "gen-astar-rpc": "yarn papi add -w wss://rpc.astar.network shibuya",
